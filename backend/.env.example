# Store ICU Backend Environment Variables

# Application
APP_NAME=Store ICU API
DEBUG=false

# Database (Cloud SQL PostgreSQL)
# Option 1: Full DATABASE_URL (local development — takes precedence)
DATABASE_URL=postgresql://aha_sicu:password@localhost:5432/aha_coms_sicu_dev
# Option 2: Individual components (Cloud Run / CI — URL constructed automatically)
# DB_USER=aha_sicu
# DB_PASSWORD=your-password
# DB_NAME=aha_coms_sicu_dev
# CLOUD_SQL_INSTANCE=project:asia-southeast2:aha-sicu-db
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5

# Firebase Admin SDK
# Local dev: path to service account JSON file
# Cloud Run: uses Application Default Credentials (ADC) automatically
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Email / Brevo Transactional API
# 1. Sign up at https://www.brevo.com (free tier: 300 emails/day)
# 2. Get API key at https://app.brevo.com/settings/keys/api
# 3. Add and verify sender at https://app.brevo.com/senders/list
BREVO_API_KEY=xkeysib-your-api-key-here
BREVO_SENDER_NAME=AHA Commerce
BREVO_SENDER_EMAIL=your-verified-sender@domain.com
EMAIL_ENABLED=false
EMAIL_ALLOWED_DOMAINS=ahacommerce.co.id

# Google Sheets API - Credentials
# Option 1: Path to service account JSON file (development)
GSHEETS_CREDENTIALS_PATH=./credentials/gsheets-service-account.json
# Option 2: Raw JSON string from Secret Manager (production)
# GSHEETS_CREDENTIALS_JSON={"type": "service_account", ...}

# VP Sheet (brand_vp_data)
GSHEETS_VP_SPREADSHEET_ID=your-vp-spreadsheet-id
GSHEETS_VP_RANGE=VP!A:Y
GSHEETS_VP_BRAND_COLUMN=Nama Brand

# 1st Meeting Sheet (brand_meeting_data)
GSHEETS_MEETING_SPREADSHEET_ID=your-meeting-spreadsheet-id
GSHEETS_MEETING_RANGE=ZAP: 1st Meeting!A:D
GSHEETS_MEETING_BRAND_COLUMN=Brand

# Evaluation Status Sheet (write-only — syncs evaluated brands)
GSHEETS_EVAL_SPREADSHEET_ID=your-eval-spreadsheet-id
GSHEETS_EVAL_TAB=SICU
