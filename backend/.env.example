# Store ICU Backend Environment Variables

# Application
APP_NAME=Store ICU API
DEBUG=false

# Database (Cloud SQL PostgreSQL)
# Option 1: Full DATABASE_URL (local development — takes precedence)
DATABASE_URL=postgresql://aha_sicu:password@localhost:5432/aha_coms_sicu_dev
# Option 2: Individual components (Cloud Run / CI — URL constructed automatically)
# DB_USER=aha_sicu
# DB_PASSWORD=your-password
# DB_NAME=aha_coms_sicu_dev
# CLOUD_SQL_INSTANCE=project:asia-southeast2:aha-sicu-db
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5

# Firebase Admin SDK
# Local dev: path to service account JSON file
# Cloud Run: uses Application Default Credentials (ADC) automatically
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Email (rich /send evaluation report — POST /api/v1/email/send)
# Sent over its OWN SMTP account (EMAIL_SMTP_*), separate from /send-plain's
# GMAIL_SMTP_* account. EMAIL_ENABLED gates this path; with it false, /send
# writes a /tmp HTML preview instead of dialing SMTP.
# EMAIL_SMTP_USER defaults to EMAIL_FROM_EMAIL when left blank.
EMAIL_FROM_NAME=AHA Commerce
EMAIL_FROM_EMAIL=your-verified-sender@domain.com
EMAIL_ENABLED=false
EMAIL_ALLOWED_DOMAINS=ahacommerce.co.id
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_APP_PASSWORD=your-16-char-app-password

# Gmail SMTP (evaluation "Send Mail" dialog — POST /api/v1/email/send-plain)
# Independent of EMAIL_ENABLED, which gates only the rich /send path.
# 1. Use a Google Workspace account with 2-Step Verification enabled
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character code below WITHOUT spaces
# Leave GMAIL_SMTP_ENABLED=false to write a /tmp preview instead of dialing SMTP.
GMAIL_SMTP_ENABLED=false
GMAIL_SMTP_USER=your-account@ahacommerce.net
GMAIL_SMTP_APP_PASSWORD=your-16-char-app-password
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587

# Google Sheets API - Credentials
# Option 1: Path to service account JSON file (development)
GSHEETS_CREDENTIALS_PATH=./credentials/gsheets-service-account.json
# Option 2: Raw JSON string from Secret Manager (production)
# GSHEETS_CREDENTIALS_JSON={"type": "service_account", ...}

# VP Sheet (brand_vp_data)
GSHEETS_VP_SPREADSHEET_ID=your-vp-spreadsheet-id
GSHEETS_VP_RANGE=VP!A:Y
GSHEETS_VP_BRAND_COLUMN=Nama Brand

# VP Sheet — Thailand (brand_vp_data, marketplace='TH')
GSHEETS_VP_SPREADSHEET_ID_TH=your-th-vp-spreadsheet-id

# 1st Meeting Sheet (brand_meeting_data)
GSHEETS_MEETING_SPREADSHEET_ID=your-meeting-spreadsheet-id
GSHEETS_MEETING_RANGE=ZAP: 1st Meeting!A:D
GSHEETS_MEETING_BRAND_COLUMN=Brand

# Evaluation Status Sheet (write-only — syncs evaluated brands)
GSHEETS_EVAL_SPREADSHEET_ID=your-eval-spreadsheet-id
GSHEETS_EVAL_TAB=SICU - bronze
