# Store ICU - Shared Terraform Variables (single apply creates both dev + prod)
# Copy to terraform.tfvars and fill in real values

project_id          = "YOUR_GCP_PROJECT_ID"
region              = "asia-southeast2"
github_repo         = "YOUR_ORG/aha_sicu"
firebase_project_id = "YOUR_GCP_PROJECT_ID"

# Cloud Run sizing (shared defaults for both environments)
cloud_run_image         = "us-docker.pkg.dev/cloudrun/container/hello"
cloud_run_min_instances = 0
cloud_run_max_instances = 2
cloud_run_memory        = "1Gi"
cloud_run_cpu           = "1"

# Google Sheets spreadsheet IDs
gsheets_vp_spreadsheet_id      = "YOUR_VP_SPREADSHEET_ID"
gsheets_meeting_spreadsheet_id = "YOUR_MEETING_SPREADSHEET_ID"
gsheets_eval_spreadsheet_id    = "YOUR_EVAL_SPREADSHEET_ID"

# Email — From address for the rich /send path
email_from_email = "noreply@ahabot.ai"

# Gmail SMTP (evaluation "Send Mail" dialog — POST /api/v1/email/send-plain)
# App Password: https://myaccount.google.com/apppasswords (16 chars, no spaces).
# The value is seeded out-of-band via gcloud; ignore_changes preserves it, so
# leaving the placeholder here will NOT overwrite an already-seeded secret.
gmail_smtp_user         = "your-account@ahacommerce.net"
gmail_smtp_app_password = "your-16-char-app-password"
dev_gmail_smtp_enabled  = true
prod_gmail_smtp_enabled = false
